# Variables del bot de reclutamiento. En EasyPanel van en la pestaña
# "Environment" de la app. NUNCA subas un .env con valores reales al repo
# (es público).

# === Chatwoot ===
CHATWOOT_BASE_URL=https://crm.adlek.com.mx
CHATWOOT_ACCOUNT_ID=1
# Bandeja WhatsApp Demos: el bot ignora cualquier otra.
CHATWOOT_INBOX_ID=3
# Ajustes → Bots → "Reclutamiento Demo" → Token de acceso. Vacío = modo prueba.
CHATWOOT_BOT_TOKEN=
# Ajustes → Bots → "Reclutamiento Demo" → Webhook Secret (verifica la firma).
CHATWOOT_WEBHOOK_SECRET=
# Opcional: llave extra en la URL del webhook (?key=...).
WEBHOOK_KEY=

# === Demo ===
# 3 horarios separados por "|" (máx. 20 caracteres cada uno).
INTERVIEW_SLOTS=Mié 30 sep 9:00|Mié 30 sep 11:30|Jue 1 oct 9:00
# Recordatorio simulado ("un día antes") y seguimiento por abandono.
REMINDER_DELAY_SECONDS=120
FOLLOWUP_DELAY_SECONDS=180
DEMO_MODE=true

# === IA (v2) ===
# Sin llave, el bot funciona con los textos fijos (igual que la v1).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
AI_ENABLED=true

# === Supabase (proyecto "demos") ===
SUPABASE_URL=https://lvvfxqdwolirpxdkhlqb.supabase.co
# Supabase → Project Settings → API Keys → service_role (secreta).
SUPABASE_SERVICE_KEY=

# === Cal.com ===
# Cal.com → Settings → Developer → API Keys.
CAL_API_KEY=
# Número del tipo de evento (aparece en la URL al editarlo, o en los logs del
# bot al arrancar si solo pones CAL_API_KEY).
CAL_EVENT_TYPE_ID=
# Correo que se registra en Cal.com por candidato (debe poder recibir correo).
CAL_ATTENDEE_EMAIL=adlekcontact+wa{digits}@gmail.com

# === Buffer de entrada ===
BUFFER_WINDOW_SECONDS=6
BUFFER_BUTTON_SECONDS=1

# === Operación ===
DB_PATH=/data/reclutamiento.db
SEND_DELAY_SECONDS=1.0
LOG_LEVEL=INFO
